[Unit]
Description=GarMyFriend display and virtual servo panel
After=network-online.target garmyfriend-devices.service
Requires=garmyfriend-devices.service
Wants=network-online.target

[Service]
Type=simple
User=gar
WorkingDirectory=/home/gar/GarMyFriend-OrangePiZero2W
Environment=GAR_SIM_ENVIRONMENT=virtualbox-linux
Environment=GAR_LIVE_BROKER_CONFIG=/home/gar/.config/garmyfriend/live-broker.json
EnvironmentFile=-/home/gar/GarMyFriend-OrangePiZero2W/.gar/build.env
EnvironmentFile=-/home/gar/.config/garmyfriend/panel.env
ExecStart=/usr/bin/node simulation/server.cjs --port 8773
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target

{
  "name": "gar-my-friend-orangepi-zero2w",
  "version": "0.2.0",
  "private": true,
  "description": "Orange Pi Zero 2W Product binding and Linux display/servo simulator for gar-my-friend",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm --prefix sources/gar-my-friend run build",
    "body": "node scripts/body.cjs",
    "audio": "node scripts/audio.cjs",
    "live": "node scripts/live.cjs",
    "test": "npm --prefix sources/gar-my-friend test && node --test tests/runtime.cjs tests/hardware.cjs sources/gar-tools/targets/linux-device/runtime/alsa-audio/duplex.test.cjs && node tests/simulator.cjs && node tests/shared-audio-browser.cjs && node tests/live-panel.cjs",
    "test:runtime": "npm --prefix sources/gar-my-friend test && node --test tests/runtime.cjs tests/hardware.cjs",
    "test:preview": "npm --prefix sources/gar-my-friend run test:preview",
    "test:simulator": "node tests/simulator.cjs",
    "vm:start": "python tools/vm.py start",
    "vm:stop": "python tools/vm.py stop",
    "vm:status": "python tools/vm.py status",
    "vm:deploy": "python tools/vm.py deploy",
    "vm:publish": "python tools/vm.py publish",
    "vm:open": "python tools/vm.py open",
    "sim": "python tools/vm.py open",
    "sim:open": "python tools/vm.py open",
    "sim:stop": "python tools/vm.py stop",
    "sim:status": "python tools/vm.py status",
    "test:vm": "node tests/vm-body.cjs",
    "test:live": "node tests/live-panel.cjs",
    "test:native-live": "node --test sources/gar-tools/targets/linux-device/runtime/alsa-audio/duplex.test.cjs tests/native-live.cjs",
    "compose": "python tools/product.py describe",
    "compose:check": "python tools/product.py validate",
    "compose:package": "python tools/product.py package",
    "test:composition": "python -m unittest discover -s tests -p test_composition.py -v"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}

{
  "schema_version": 1,
  "id": "garmyfriend-orangepi-zero2w",
  "components": {
    "application": "sources/gar-my-friend",
    "tools": "sources/gar-tools",
    "board": "sources/board-orangepi-zero2w"
  },
  "board_profile": "armbian-debian13",
  "hardware": {
    "physical": "hardware/orangepi-zero2w",
    "simulation": "hardware",
    "spi_miso": false
  },
  "build": {
    "script": "tools/build-native.sh",
    "directory": "build/composed-arm64",
    "outputs": [
      "device-output",
      "gar_rotary_input",
      "gar-servoctl"
    ],
    "environment": {
      "GAR_BUILD_SERVO": "1"
    }
  },
  "launch": {
    "entrypoint": "scripts/run-face.cjs"
  },
  "runtime": {
    "version": "24.22.1",
    "archive": "node-v24.22.1-linux-arm64.tar.xz",
    "url": "https://nodejs.org/dist/v24.22.1/node-v24.22.1-linux-arm64.tar.xz",
    "sha256": "dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e"
  },
  "deployment": {
    "root": "/opt/garmyfriend",
    "user": "garmyfriend",
    "legacy_services": [
      "garmyfriend.service"
    ],
    "runtime_directory": "garmyfriend-orangepi-zero2w",
    "supplementary_groups": [
      "i2c",
      "audio"
    ]
  },
  "payload": [
    "product.json",
    "scripts/run-face.cjs",
    "scripts/body.cjs",
    "scripts/audio.cjs",
    "scripts/live.cjs",
    "hardware/orangepi-zero2w",
    "sources/gar-my-friend/application",
    "sources/gar-my-friend/tools/body.cjs",
    "sources/gar-my-friend/tools/audio.cjs",
    "sources/gar-my-friend/tools/live.cjs",
    "sources/gar-my-friend/tools/say.cjs",
    "sources/gar-tools/targets/linux-device/runtime/alsa-audio/audio.cjs",
    "sources/gar-tools/targets/linux-device/runtime/alsa-audio/duplex.cjs",
    "sources/gar-tools/targets/linux-device/runtime/gemini-live/broker.cjs",
    "sources/gar-tools/web-simulator/components/gemini-live.mjs",
    "sources/gar-tools/web-simulator/components/audio-pcm.mjs",
    "sources/gar-my-friend/firmware",
    "sources/gar-my-friend/shared",
    "hardware/components.csv",
    "hardware/connections.csv"
  ]
}
